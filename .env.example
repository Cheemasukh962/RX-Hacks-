# Backend (backend/.env). Never commit real keys. Never put these in the browser
# and never prefix secrets with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# Comma-separated allowed origins for the frontend, e.g. https://rexo.vercel.app,http://127.0.0.1:3000
CORS_ORIGINS=*

# Frontend: copy frontend/.env.example to frontend/.env.local.
# NEXT_PUBLIC_API_URL=http://localhost:8000   (leave empty for the self-contained seeded demo)
