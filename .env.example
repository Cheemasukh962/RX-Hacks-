# Backend (backend/.env). Never commit real keys. Never put these in the browser.
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# Comma-separated allowed origins for the frontend, e.g. https://rexo.vercel.app,http://localhost:3000
CORS_ORIGINS=*

# Frontend (frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
